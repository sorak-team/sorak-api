# ── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sorak:sorak@localhost:5432/sorak?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_yyyyyy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Cloud Object Storage (MinIO S3) ──────────────────────────────────────────
# Leave MINIO_ENDPOINT blank to use local filesystem storage (/uploads/avatars)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sorak-media
MINIO_PUBLIC_URL=http://localhost:9000/sorak-media